# ─────────────────────────────────────────────────────────────────
# Holodeck local environment template.
#
# Copy to `.env` (gitignored) and fill in the values, then `npm start`.
# start-web.js loads this file and FAILS FAST if a required var is
# missing, so a misconfigured stack dies at boot instead of serving a
# half-broken app (get-session 404 / rest/v1 401). Real environment
# variables (e.g. Heroku config vars) always win over this file.
# ─────────────────────────────────────────────────────────────────

# ── Required: Postgres + auth ──────────────────────────────────────

# Postgres connection string. MUST include a login role in the userinfo
# (postgresql://USER@host/db) — PostgREST SET ROLEs into the token's
# `role` claim, which the auth-shim derives from this URI. Without a
# role, every authenticated /rest/v1 call is rejected as anonymous.
# Local dev example (role = your OS/db user):
DATABASE_URL=postgresql://YOUR_DB_ROLE@localhost/holodeck

# HS256 secret shared by the auth-shim (signs minted tokens) and
# PostgREST (verifies them). Any sufficiently random string works
# locally as long as both use the same one — start-web.js passes this
# single value to both children. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Neon Auth (Better Auth) origin and JWKS. Non-secret URLs from your
# Neon project console (Auth tab). The /auth/** proxy is only registered
# when NEON_AUTH_BASE is set; NEON_JWKS_URL is derived from it if omitted.
NEON_AUTH_BASE=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_JWKS_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json

# ── Required for the AI features: Gemini proxy ─────────────────────

# Gemini Developer API key. Used by the /api/gemini/* proxy in server.js
# (e.g. "Generate script with Gemini"). Without it those routes 500.
GEMINI_API_KEY=

# ── Optional ───────────────────────────────────────────────────────

# GEMINI_TEXT_MODEL=gemini-2.5-flash

# Google Cloud Storage for uploaded images/logos (server.js sign/proxy).
GCS_BUCKET=holodeck_images
GOOGLE_APPLICATION_CREDENTIALS=./holodeck-gcs-key.json
